# Copy to .env
ANTHROPIC_API_KEY=

# Optional
# PORT=5220
# ADMIN_PIN=4242            # coach console gate — CHANGE IN PROD
# DATA_DIR=/data            # set on Railway (volume) so the db survives deploys

# --- Testing only (leave UNSET in prod) ---
# FAST_TIMERS=1             # collapse Phase 4 timers for the redline suite:
#                          #   autopilot humanizing delay 60-180s -> 2-4s
#                          #   persona (sim lead) reply delay 3-8s -> 1-2s
#                          #   follow-up 'hours' settings reinterpreted as SECONDS
#                          # The follow-up sweep still runs every 15s regardless.

# --- Instagram adapter (dormant until all three are set) ---
# Create a Meta app (developers.facebook.com), add Instagram Messaging,
# connect your IG professional account, then:
# IG_PAGE_TOKEN=            # long-lived page access token
# IG_VERIFY_TOKEN=          # any secret string; also paste it in the Meta webhook config
# IG_BUSINESS_ID=           # your Instagram business account id
# IG_APP_SECRET=            # Meta app → Settings → Basic → App Secret. REQUIRED once the
#                          # three above are set: unsigned webhooks are rejected so nobody
#                          # can forge lead messages and make the bot DM people.

# --- Optional integrations ---
# RESEND_API_KEY=           # owner email notifications (flags, bookings, parked drafts)
# NOTIFY_FROM=              # sender address for those emails
# GROQ_API_KEY=             # voice-note transcription (whisper-large-v3, free tier)
# OPENAI_API_KEY=           # fallback transcription (whisper-1)
# PUBLIC_BASE_URL=          # public https origin (Railway sets RAILWAY_PUBLIC_DOMAIN automatically)
# FFMPEG_PATH=              # only if ffmpeg is not on PATH
