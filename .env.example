# Copy to .env for local development. On Railway set these in the service's
# Variables tab. docs/META_REVIEW.md section 5 explains where each Meta value comes from.

# ===== Required in production =====
ANTHROPIC_API_KEY=            # AI drafting
OWNER_EMAIL=                  # your login email; you become the platform admin
DATA_DIR=/data                # Railway volume mount path, so the database survives deploys
TOKEN_ENC_KEY=                # openssl rand -hex 32. Encrypts Instagram/Page tokens at rest.
                              # Without it a key is generated into DATA_DIR/.token_key. Keep it
                              # forever: changing it means every account must reconnect.

# ----- Instagram API with Instagram Login (Meta app > Instagram > API setup with Instagram login) -----
IG_APP_ID=                    # Instagram app ID (not the Facebook App ID). Turns on "Connect Instagram".
IG_APP_SECRET=                # Instagram app secret. Verifies webhooks; production rejects all
                              # Instagram webhooks while neither app secret is set.
META_APP_SECRET=              # App settings > Basic > App secret. Also accepted for webhook and
                              # signed_request signatures; set both to be safe.
IG_VERIFY_TOKEN=              # openssl rand -hex 24; paste the same value in the Meta webhook form

# ----- Company details shown on /privacy, /terms and /data-deletion -----
# Unset values show a red [placeholder]. Do not submit for App Review while any show.
COMPANY_NAME=                 # exactly as on Companies House, e.g. JD Osas Ltd
COMPANY_EMAIL=                # privacy and support contact
COMPANY_ADDRESS=              # registered office address
COMPANY_NUMBER=               # Companies House number
# COMPANY_ICO_NUMBER=         # ICO data protection fee registration number, once you have it
# PRODUCT_NAME=dmSetter       # product name on the legal pages
# HOSTING_PROVIDER=           # defaults to "Railway Corporation (cloud hosting, United States)"

# ----- Email (sign-in links and owner notifications) -----
RESEND_API_KEY=               # without it, sign-in links cannot be emailed in production
NOTIFY_FROM=                  # sender address on a domain verified in Resend

# ===== Optional =====
# PORT=5220
# PUBLIC_BASE_URL=            # public https origin; Railway sets RAILWAY_PUBLIC_DOMAIN automatically.
#                             # Set this when you use a custom domain (OAuth redirect and webhooks use it).

# ----- Single-account env token (the first account only; OAuth accounts don't need these) -----
# IG_PAGE_TOKEN=              # long-lived Instagram token
# IG_BUSINESS_ID=             # Instagram professional account id

# ----- Facebook Messenger channel (first account; other accounts connect a Page in Settings) -----
# FB_PAGE_ID=
# FB_PAGE_TOKEN=
# FB_VERIFY_TOKEN=            # defaults to IG_VERIFY_TOKEN

# ----- Sign-in -----
# OPEN_LOGIN_EMAILS=          # TEMPORARY: these addresses sign in without an email link (e.g. the
#                             # Meta reviewer). Ignored in production unless the next line is set.
# OPEN_LOGIN_IN_PRODUCTION=1
# ALLOW_LEGACY_PIN=1          # old x-admin-pin sign-in; production refuses to start without ADMIN_PIN
# ADMIN_PIN=                  # only used when ALLOW_LEGACY_PIN=1

# ----- Voice notes -----
# GROQ_API_KEY=               # transcription (whisper-large-v3)
# OPENAI_API_KEY=             # fallback transcription (whisper-1)
# FFMPEG_PATH=                # only if ffmpeg is not on PATH

# ----- Monitoring and backups -----
# SENTRY_DSN=                 # error monitoring (SENTRY_RELEASE defaults to the Railway commit)
# LOG_FORMAT=json             # structured logs
# BACKUP_S3_BUCKET=           # off-site backups (S3 compatible). Set a 30 day lifecycle rule on
# BACKUP_S3_ACCESS_KEY=       # the bucket: the privacy policy promises at most 30 days.
# BACKUP_S3_SECRET_KEY=
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_REGION=us-east-1
# BACKUP_S3_PREFIX=dmsetter/

# ----- Send limits (defaults shown; per-account settings can tighten them) -----
# IG_RATE_MIN_INTERVAL_MS=2000    # gap between two sends from one account
# IG_RATE_MAX_PER_HOUR=100        # sends per account per hour
# IG_RATE_MAX_QUEUE_WAIT_MS=60000 # a send that would wait longer is held for review
# IG_RATE_BACKOFF_MS=60000        # first back-off after a Meta rate-limit error
# IG_STALE_SEND_MINUTES=30        # queued work older than this after downtime is parked

# ----- Request limits (defaults shown) -----
# RATE_LIMIT_AUTH_IP=20  RATE_LIMIT_AUTH_EMAIL=5  RATE_LIMIT_AUTH_ACCOUNT=15
# RATE_LIMIT_PUBLIC_IP=60  RATE_LIMIT_INVITE_ACCOUNT=20
# SSE_MAX_PER_ACCOUNT=20  SSE_REVALIDATE_MS=60000

# ===== Testing only: leave UNSET in production =====
# FAST_TIMERS=1               # collapses delays to seconds for the test suites (ignored in production)
# ATTACH_ALLOW_ANY_HOST=1
# IG_GRAPH_BASE=  FB_GRAPH_BASE=   # point the Graph API at a local stub
